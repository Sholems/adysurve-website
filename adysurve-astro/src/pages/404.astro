---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | ADYSURVE LTD"
  description="The page you are looking for does not exist or has been moved. Return to the ADYSURVE LTD homepage."
>
  <section class="flex min-h-[calc(100vh-16rem)] items-center justify-center bg-white py-20">
    <div class="container-page text-center">
      <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-3xl bg-primary/10 sm:h-28 sm:w-28">
        <svg class="h-12 w-12 text-primary-dark sm:h-14 sm:w-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </div>

      <h1 class="mt-8 font-display text-7xl font-extrabold leading-none text-dark-deeper sm:text-8xl">404</h1>
      <p class="mt-4 font-display text-2xl font-extrabold text-dark-deeper sm:text-3xl">Page not found</p>
      <p class="mx-auto mt-4 max-w-lg leading-8 text-dark/65">
        The page you are looking for does not exist or may have been moved. 
        Let us help you find your way back.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-4 text-sm font-extrabold text-dark-deeper shadow-xl shadow-primary/20 transition hover:bg-primary-light"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back to Home
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-full border border-dark-deeper px-7 py-4 text-sm font-extrabold text-dark-deeper transition hover:border-primary hover:text-primary"
        >
          Contact Us
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="mx-auto mt-14 grid max-w-lg gap-4 sm:grid-cols-3">
        <a href="/services" class="rounded-xl border border-black/8 bg-light p-4 text-sm font-bold text-dark-deeper transition hover:border-primary/30 hover:shadow-md">
          Services
        </a>
        <a href="/projects" class="rounded-xl border border-black/8 bg-light p-4 text-sm font-bold text-dark-deeper transition hover:border-primary/30 hover:shadow-md">
          Projects
        </a>
        <a href="/blog" class="rounded-xl border border-black/8 bg-light p-4 text-sm font-bold text-dark-deeper transition hover:border-primary/30 hover:shadow-md">
          Blog
        </a>
      </div>
    </div>
  </section>
</Layout>
