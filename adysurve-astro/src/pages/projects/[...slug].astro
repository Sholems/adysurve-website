---
import Layout from '../../layouts/Layout.astro';
import { getProjects, getServices } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

// Get related projects (same service, excluding current)
const allProjects = await getProjects();
const relatedProjects = allProjects
  .filter((p) => p.id !== project.id && p.data.isActive)
  .filter((p) => !data.serviceSlug || p.data.serviceSlug === data.serviceSlug)
  .slice(0, 3);

// Get service name
const services = await getServices();
const service = services.find((s) => s.id === data.serviceSlug);
const serviceName = service?.data?.title || data.serviceSlug;
---

<Layout
  title={`${data.metaTitle || data.title + ' | ADYSURVE Project'} | ADYSURVE LTD`}
  description={data.metaDescription || data.description}
  image={data.featuredImage}
>
  <section class="bg-dark-deeper py-14 text-white sm:py-20">
    <div class="container-page">
      <a href="/projects" class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-light">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        Back to Projects
      </a>
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-primary/15 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-light">{serviceName}</span>
        {data.location && (
          <span class="flex items-center gap-1 text-sm text-white/60">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {data.location}
          </span>
        )}
        {data.clientName && (
          <span class="text-sm text-white/60">Client: {data.clientName}</span>
        )}
      </div>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">{data.title}</h1>
    </div>
  </section>

  <!-- Featured Image -->
  {data.featuredImage && (
    <div class="bg-white pb-8 pt-0 md:pb-12">
      <div class="container-page">
        <div class="-mt-10 overflow-hidden rounded-2xl shadow-2xl md:-mt-16">
          <img src={data.featuredImage} alt={data.title} width="1200" height="750" loading="eager" class="w-full object-cover" />
        </div>
      </div>
    </div>
  )}

  <!-- Description -->
  <section class="pb-16 md:pb-28">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[1fr_0.9fr]">
        <div>
          <h2 class="font-display text-2xl font-extrabold text-dark-deeper md:text-3xl">Project Overview</h2>
          <div class="prose prose-lg mt-4 max-w-none prose-p:text-[var(--color-text-muted)] prose-p:leading-8">
            <p>{data.description}</p>
          </div>

          {data.galleryImages && data.galleryImages.length > 0 && (
            <div class="mt-10">
              <h3 class="font-display text-xl font-extrabold text-dark-deeper">Project Gallery</h3>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {data.galleryImages.map((img, i) => (
                  <div class="overflow-hidden rounded-xl shadow-lg">
                    <img src={img} alt={`${data.title} - image ${i + 1}`} width="600" height="400" loading="lazy" class="w-full object-cover" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside>
          <div class="sticky top-28 rounded-2xl border border-black/8 bg-white p-6 shadow-lg sm:p-8">
            <h3 class="font-display text-xl font-extrabold text-dark-deeper">Project Details</h3>
            <dl class="mt-5 space-y-4">
              {serviceName && (
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-dark/50">Service</dt>
                  <dd class="mt-1 text-sm font-medium text-dark-deeper">{serviceName}</dd>
                </div>
              )}
              {data.clientName && (
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-dark/50">Client</dt>
                  <dd class="mt-1 text-sm font-medium text-dark-deeper">{data.clientName}</dd>
                </div>
              )}
              {data.location && (
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-dark/50">Location</dt>
                  <dd class="mt-1 text-sm font-medium text-dark-deeper">{data.location}</dd>
                </div>
              )}
              {data.isFeatured && (
                <div>
                  <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary-dark">Featured Project</span>
                </div>
              )}
            </dl>
            <a href={`/contact?project=${project.id}`} class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-center text-sm font-extrabold text-dark-deeper transition hover:bg-primary-light">
              Discuss a Similar Project
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Related Projects -->
  {relatedProjects.length > 0 && (
    <section class="bg-light py-16 md:py-24">
      <div class="container-page">
        <h2 class="font-display text-3xl font-extrabold text-dark-deeper md:text-4xl">Related Projects</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {relatedProjects.map((rp) => (
            <a href={`/projects/${rp.id}`} class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
              {rp.data.featuredImage && (
                <div class="aspect-[16/10] overflow-hidden">
                  <img src={rp.data.featuredImage} alt="" width="400" height="250" loading="lazy" class="h-full w-full object-cover transition group-hover:scale-105" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-display text-base font-extrabold leading-snug text-dark-deeper group-hover:text-primary-dark">{rp.data.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-7 text-dark/65 line-clamp-2">{rp.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-primary py-16 text-dark-deeper">
    <div class="container-page flex flex-col items-stretch justify-between gap-6 md:flex-row md:items-center">
      <h2 class="font-display text-3xl font-extrabold md:text-4xl">Have a similar project in mind?</h2>
      <a href="/contact" class="rounded-full bg-dark-deeper px-7 py-4 text-center font-bold text-white">Get in Touch</a>
    </div>
  </section>
</Layout>
