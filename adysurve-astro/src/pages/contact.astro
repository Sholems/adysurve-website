---
import Layout from '../layouts/Layout.astro';
import { getServices, getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
const services = await getServices();
const s = settings?.data;
const activeServices = services.filter((s) => s.data.isActive).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const CONSULTATION_SLOTS = [
  { label: '09:00 AM', value: '09:00' },
  { label: '10:00 AM', value: '10:00' },
  { label: '11:00 AM', value: '11:00' },
  { label: '12:00 PM', value: '12:00' },
  { label: '02:00 PM', value: '14:00' },
  { label: '03:00 PM', value: '15:00' },
  { label: '04:00 PM', value: '16:00' },
];

const CONSULTATION_MODES = ['Phone Call', 'WhatsApp', 'Video Call', 'Office Visit'];
---

<Layout
  title="Contact ADYSURVE LTD | Get a Free Consultation"
  description="Contact ADYSURVE LTD for IT support, CCTV installation, solar energy, and graphic design services in Nigeria. Request a free quote today."
>
  <section class="bg-dark-deeper py-14 text-white sm:py-20">
    <div class="container-page">
      <p class="text-sm font-bold uppercase tracking-widest text-primary">ADYSURVE LTD</p>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">Contact ADYSURVE LTD</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-white/75 sm:text-lg">Request a consultation, quote, support visit, or project conversation.</p>
    </div>
  </section>

  <!-- Free Consultation Booking Section -->
  <section id="free-consultation" class="scroll-mt-24 bg-light py-16 md:py-24">
    <div class="container-page grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-widest text-primary">Free Consultation</p>
        <h2 class="mt-3 max-w-3xl font-display text-3xl font-extrabold leading-tight text-dark-deeper md:text-5xl">Book a free consultation with ADYSURVE LTD.</h2>
        <p class="mt-5 max-w-2xl leading-8 text-dark/68">Choose a preferred date, time slot, and consultation mode. Our team will review your request and confirm availability shortly.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {[
            { icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', title: 'Pick a Date', text: 'Select a weekday that works for your schedule.' },
            { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Choose a Time', text: 'Available slots run during business hours.' },
            { icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z', title: 'Select Mode', text: 'Phone, WhatsApp, video call, or office visit.' },
            { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Get Confirmation', text: 'Our team confirms the appointment after review.' },
          ].map((item) => (
            <div class="rounded-lg border border-black/10 bg-white p-5 shadow-sm">
              <svg class="h-8 w-8 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={item.icon} />
              </svg>
              <h3 class="mt-4 font-display text-lg font-extrabold text-dark-deeper">{item.title}</h3>
              <p class="mt-2 text-sm leading-7 text-dark/65">{item.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Consultation Booking Form -->
      <div
        x-data="{
          name: '', email: '', phone: '', service_interest: '',
          preferred_date: '', preferred_time: '', meeting_mode: '',
          notes: '', website: '', submitted: false, error: '', errors: [],
          submitting: false,
          async submitForm() {
            this.submitting = true;
            this.error = '';
            this.errors = [];
            try {
              const res = await fetch('/api/consultation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: this.name, email: this.email, phone: this.phone,
                  service_interest: this.service_interest,
                  preferred_date: this.preferred_date,
                  preferred_time: this.preferred_time,
                  meeting_mode: this.meeting_mode, notes: this.notes,
                  website: this.website,
                }),
              });
              const data = await res.json();
              if (data.success) {
                this.submitted = true;
                this.name = ''; this.email = ''; this.phone = '';
                this.service_interest = ''; this.preferred_date = '';
                this.preferred_time = ''; this.meeting_mode = ''; this.notes = '';
              } else {
                this.errors = data.errors || [];
                this.error = data.errors?.[0] || 'Please fix the errors above.';
              }
            } catch (e) {
              this.error = 'Network error. Please try again.';
            } finally {
              this.submitting = false;
            }
          }
        }"
        x-init="const params = new URLSearchParams(window.location.search); const svc = params.get('service'); if (svc) service_interest = svc;"
        class="rounded-2xl border border-black/10 bg-white p-5 shadow-2xl shadow-black/8 sm:p-8"
      >
        <form @submit.prevent="submitForm" class="space-y-5">
          <input type="text" name="website" x-model="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">

          <div x-show="submitted" x-cloak class="rounded-xl border border-green-200 bg-green-50 p-5 text-sm font-medium text-green-800">
            Your free consultation has been requested. Our team will confirm the appointment shortly.
          </div>

          <div x-show="error && !submitted" x-cloak class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700" x-text="error"></div>

          <template x-if="!submitted">
            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <label for="consult-name" class="text-sm font-bold text-dark-deeper">Full Name *</label>
                <input id="consult-name" type="text" x-model="name" required class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="Your name" />
              </div>
              <div>
                <label for="consult-email" class="text-sm font-bold text-dark-deeper">Email Address *</label>
                <input id="consult-email" type="email" x-model="email" required class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="you@example.com" />
              </div>
              <div>
                <label for="consult-phone" class="text-sm font-bold text-dark-deeper">Phone Number</label>
                <input id="consult-phone" type="tel" x-model="phone" class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="+234 XXX XXX XXXX" />
              </div>
              <div>
                <label for="consult-service" class="text-sm font-bold text-dark-deeper">Service or Training</label>
                <select id="consult-service" x-model="service_interest" class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                  <option value="">Select service or training</option>
                  {activeServices.map((svc) => (
                    <option value={svc.data.title}>{svc.data.title}</option>
                  ))}
                  <option value="Network & Security Training">Network & Security Training</option>
                  <option value="CCTV Installation Training">CCTV Installation Training</option>
                  <option value="Solar Renewable Energy Training">Solar Renewable Energy Training</option>
                  <option value="IT Essentials for Beginners">IT Essentials for Beginners</option>
                  <option value="Graphic Design & Media Training">Graphic Design & Media Training</option>
                </select>
              </div>
              <div>
                <label for="consult-date" class="text-sm font-bold text-dark-deeper">Preferred Date *</label>
                <input id="consult-date" type="date" x-model="preferred_date" :min="new Date().toISOString().split('T')[0]" required class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" />
              </div>
              <div>
                <label for="consult-mode" class="text-sm font-bold text-dark-deeper">Meeting Mode *</label>
                <select id="consult-mode" x-model="meeting_mode" required class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                  <option value="">Select mode...</option>
                  {CONSULTATION_MODES.map((mode) => (
                    <option value={mode}>{mode}</option>
                  ))}
                </select>
              </div>
            </div>
          </template>

          <template x-if="!submitted">
            <>
              <div>
                <p class="text-sm font-bold text-dark-deeper">Preferred Time *</p>
                <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                  {CONSULTATION_SLOTS.map((slot) => (
                    <label class="cursor-pointer">
                      <input type="radio" x-model="preferred_time" value={slot.value} required class="peer sr-only" />
                      <span class="block rounded-lg border border-black/10 bg-light px-3 py-3 text-center text-sm font-extrabold text-dark-deeper transition peer-checked:border-primary peer-checked:bg-primary peer-checked:text-dark-deeper">{slot.label}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div>
                <label for="consult-notes" class="text-sm font-bold text-dark-deeper">Project Notes</label>
                <textarea id="consult-notes" x-model="notes" rows="5" class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="Tell us what you would like to discuss."></textarea>
              </div>

              <button type="submit" :disabled="submitting" class="w-full rounded-full bg-primary px-7 py-4 text-center text-sm font-extrabold text-dark-deeper shadow-xl shadow-primary/20 transition hover:bg-primary-light disabled:opacity-50">
                <span x-show="!submitting">Book Free Consultation</span>
                <span x-show="submitting" x-cloak>Submitting...</span>
              </button>
            </>
          </template>
        </form>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-16 md:py-28">
    <div class="container-page grid gap-8 lg:grid-cols-[1fr_420px] lg:gap-12">
      <!-- Contact Form -->
      <div
        x-data="{
          name: '', email: '', phone: '', service: '',
          message: '', website: '', submitted: false, error: '', submitting: false,
          async submitForm() {
            this.submitting = true;
            this.error = '';
            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: this.name, email: this.email, phone: this.phone,
                  service_interest: this.service, message: this.message,
                  subject: `Website enquiry from ${this.name}`,
                  website: this.website,
                }),
              });
              const data = await res.json();
              if (data.success) {
                this.submitted = true;
                this.name = ''; this.email = ''; this.phone = '';
                this.service = ''; this.message = '';
              } else {
                this.error = data.errors?.[0] || 'Please fix the errors above.';
              }
            } catch (e) {
              this.error = 'Network error. Please try again.';
            } finally {
              this.submitting = false;
            }
          }
        }"
        x-init="const params = new URLSearchParams(window.location.search); const svc = params.get('service'); if (svc) service = svc;"
        class="rounded-2xl border border-black/10 bg-white p-5 shadow-lg sm:p-8"
      >
        <h2 class="font-display text-3xl font-extrabold text-dark-deeper">Send us a message</h2>
        <p class="mt-3 text-base text-dark/65">We'll get back to you within 24 hours.</p>

        <form @submit.prevent="submitForm" class="mt-8 grid gap-5">
          <div x-show="submitted" x-cloak class="rounded-xl border border-green-200 bg-green-50 p-5 text-sm font-medium text-green-800">
            Thank you! Your message has been received. We'll get back to you within 24 hours.
          </div>

          <div x-show="error && !submitted" x-cloak class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700" x-text="error"></div>

          <template x-if="!submitted">
            <>
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="contact-name" class="text-sm font-bold text-dark-deeper">Full Name *</label>
                  <input id="contact-name" type="text" x-model="name" required class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="Your name" />
                </div>
                <div>
                  <label for="contact-email" class="text-sm font-bold text-dark-deeper">Email Address *</label>
                  <input id="contact-email" type="email" x-model="email" required class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="you@example.com" />
                </div>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="contact-phone" class="text-sm font-bold text-dark-deeper">Phone Number</label>
                  <input id="contact-phone" type="tel" x-model="phone" class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="+234 XXX XXX XXXX" />
                </div>
                <div>
                  <label for="contact-service" class="text-sm font-bold text-dark-deeper">Service Interested In</label>
                  <select id="contact-service" x-model="service" class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                    <option value="">Select a service...</option>
                    {activeServices.map((svc) => (
                      <option value={svc.data.title}>{svc.data.title}</option>
                    ))}
                    <option value="General Inquiry">General Inquiry</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="contact-message" class="text-sm font-bold text-dark-deeper">Message *</label>
                <textarea id="contact-message" x-model="message" required rows="6" class="mt-1.5 block w-full rounded-xl border border-black/15 bg-white px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="Tell us about your project or inquiry..."></textarea>
              </div>

              <button type="submit" :disabled="submitting" class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-sm font-extrabold text-dark-deeper shadow-xl shadow-primary/20 transition hover:bg-primary-light disabled:opacity-50">
                <span x-show="!submitting">
                  Send Message
                  <svg class="inline-block h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                </span>
                <span x-show="submitting" x-cloak>Submitting...</span>
              </button>
            </>
          </template>
        </form>
      </div>

      <!-- Contact Info Sidebar -->
      <aside class="space-y-5">
        <div class="rounded-2xl border border-black/8 bg-white p-6 shadow-lg sm:p-8">
          <h3 class="font-display text-xl font-extrabold text-dark-deeper">Contact Information</h3>

          <div class="mt-6 space-y-5">
            <div class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary-dark">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-dark-deeper">Address</p>
                <p class="mt-0.5 text-sm text-dark/65">{s?.siteAddress || 'Nigeria'}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary-dark">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-dark-deeper">Phone</p>
                <a href={`tel:${s?.sitePhone || '+234XXXXXXXXXX'}`} class="mt-0.5 block text-sm text-dark/65 hover:text-primary">{s?.sitePhone || '+234 XXX XXX XXXX'}</a>
              </div>
            </div>

            <div class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary-dark">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-dark-deeper">Email</p>
                <a href={`mailto:${s?.siteEmail || 'info@adysurve.com'}`} class="mt-0.5 block text-sm text-dark/65 hover:text-primary">{s?.siteEmail || 'info@adysurve.com'}</a>
              </div>
            </div>

            <div class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary-dark">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-dark-deeper">Business Hours</p>
                <p class="mt-0.5 text-sm text-dark/65">{s?.businessHours || 'Mon-Fri, 8:00-17:00'}</p>
              </div>
            </div>
          </div>

          {s?.siteWhatsapp && (
            <a href={`https://wa.me/${s.siteWhatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-green-600 px-6 py-3 text-center text-sm font-extrabold text-white transition hover:bg-green-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
          )}

          <div class="mt-5 flex flex-wrap gap-3">
            <span class="text-sm font-bold text-dark-deeper">Connect</span>
            {(s?.facebookUrl || s?.linkedinUrl || s?.instagramUrl || s?.youtubeUrl) ? (
              <>
                {s?.facebookUrl && <a href={s.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-dark/50 hover:text-primary" aria-label="Facebook"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12S0 5.446 0 12.073c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>}
                {s?.linkedinUrl && <a href={s.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-dark/50 hover:text-primary" aria-label="LinkedIn"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>}
