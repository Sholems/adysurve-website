---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const services = await getCollection('services');
const testimonials = await getCollection('testimonials');
const blogPosts = await getCollection('blog');
const settings = await getEntry('settings', 'site');
const s = settings?.data;

const activeServices = services
  .filter((s) => s.data.isActive)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const activeTestimonials = testimonials.filter((t) => t.data.isActive);

const recentPosts = blogPosts
  .filter((p) => p.data.isPublished)
  .sort((a, b) => {
    const aDate = a.data.publishedAt ?? new Date(0);
    const bDate = b.data.publishedAt ?? new Date(0);
    return bDate.getTime() - aDate.getTime();
  })
  .slice(0, 3);
---

<Layout
  title={s?.heroHeadline ? `${s.heroHeadline} | ADYSURVE LTD` : 'ADYSURVE LTD | IT, Security, CCTV, Solar & Media Solutions'}
  description={s?.aboutSummary || 'ADYSURVE LTD delivers professional IT infrastructure, CCTV surveillance, solar energy, IT training, and graphic design solutions in Nigeria.'}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-dark-deeper text-white lg:min-h-[calc(100vh-5rem)]">
    <picture>
      <source
        type="image/webp"
        srcset="
          /images/adysurve-hero-survey-engineering-768.webp 768w,
          /images/adysurve-hero-survey-engineering-1200.webp 1200w,
          /images/adysurve-hero-survey-engineering-1920.webp 1920w
        "
        sizes="100vw"
      />
      <img
        src="/images/adysurve-hero-survey-engineering.jpg"
        alt="ADYSURVE engineering professionals working on a solar installation"
        width="1920"
        height="1152"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center opacity-20"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/78 to-black/60"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_28%,rgba(201,151,43,0.22),transparent_30%),radial-gradient(circle_at_82%_38%,rgba(232,184,75,0.13),transparent_32%)]"></div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-dark-deeper to-transparent"></div>

    <div class="container-page relative grid items-center gap-10 py-14 sm:py-16 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-[1fr_0.88fr] lg:py-24">
      <div>
        <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-primary-light shadow-2xl backdrop-blur-md sm:gap-3 sm:px-4 sm:text-xs sm:tracking-widest">
          <span class="h-2 w-2 rounded-full bg-primary"></span>
          <span class="truncate">IT &bull; Security &bull; Energy &bull; Media</span>
        </div>
        <h1 class="mt-6 max-w-4xl font-display text-[2.35rem] font-extrabold leading-[1.08] tracking-normal text-white drop-shadow-2xl sm:text-5xl xl:text-6xl">
          {s?.heroHeadline || 'Professional IT, Security & Energy Solutions'}
        </h1>
        <p class="mt-6 max-w-3xl text-base font-medium leading-8 text-white/88 drop-shadow-lg sm:text-lg md:text-2xl md:leading-10">
          {s?.heroSubheadline || 'We protect your infrastructure, power your future, and connect your world.'}
        </p>
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:items-center sm:gap-4">
          <a href="/contact" class="rounded-full bg-primary px-6 py-4 text-center text-sm font-extrabold text-dark-deeper shadow-2xl shadow-black/30 transition hover:bg-primary-light sm:px-8">Request a Consultation</a>
          <a href="/services" class="rounded-full border border-white/60 bg-white/10 px-6 py-4 text-center text-sm font-extrabold text-white backdrop-blur-md transition hover:border-primary hover:text-primary sm:px-8">Explore Services</a>
        </div>
        <div class="mt-9 grid max-w-3xl gap-3 sm:grid-cols-3 lg:mt-12">
          <div class="rounded-lg border border-white/15 bg-white/10 px-4 py-3 text-sm font-bold text-white/90 shadow-xl backdrop-blur-md sm:py-4">Reliable Infrastructure</div>
          <div class="rounded-lg border border-white/15 bg-white/10 px-4 py-3 text-sm font-bold text-white/90 shadow-xl backdrop-blur-md sm:py-4">Smart Security Systems</div>
          <div class="rounded-lg border border-white/15 bg-white/10 px-4 py-3 text-sm font-bold text-white/90 shadow-xl backdrop-blur-md sm:py-4">Sustainable Energy</div>
        </div>
      </div>

      <div class="relative hidden lg:block">
        <div class="absolute -inset-5 rounded-[2rem] border border-primary/30 bg-primary/10 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-white/18 bg-white/10 p-3 shadow-2xl shadow-black/40 backdrop-blur-md">
          <picture>
            <source
              type="image/webp"
              srcset="/images/adysurve-hero-survey-engineering-768.webp 768w, /images/adysurve-hero-survey-engineering-1200.webp 1200w"
              sizes="(min-width: 1024px) 42vw, 100vw"
            />
            <img
              src="/images/adysurve-hero-survey-engineering.jpg"
              alt="ADYSURVE field engineering and solar installation work"
              width="1200"
              height="900"
              class="aspect-[4/5] w-full rounded-[1.35rem] object-cover object-center"
            />
          </picture>
          <div class="absolute left-8 top-8 rounded-full border border-white/20 bg-black/45 px-5 py-3 text-sm font-extrabold text-white shadow-xl backdrop-blur-md">Precision-led delivery</div>
          <div class="absolute bottom-8 left-8 right-8 grid grid-cols-2 gap-3">
            <div class="rounded-lg border border-white/15 bg-black/45 p-5 backdrop-blur-md">
              <p class="font-display text-3xl font-extrabold text-primary">{activeServices.length}</p>
              <p class="mt-1 text-xs font-bold uppercase tracking-widest text-white/75">Core Services</p>
            </div>
            <div class="rounded-lg border border-white/15 bg-black/45 p-5 backdrop-blur-md">
              <p class="font-display text-3xl font-extrabold text-primary">500+</p>
              <p class="mt-1 text-xs font-bold uppercase tracking-widest text-white/75">Projects Done</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="relative z-10 -mt-7 sm:-mt-10">
    <div class="container-page grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {['500+ Projects', `${activeServices.length} Core Services`, '98% Client Satisfaction', '10+ Years Experience'].map((stat) => (
        <div class="rounded-lg bg-white p-4 text-center font-display text-base font-bold shadow-xl sm:p-6 sm:text-xl">{stat}</div>
      ))}
    </div>
  </section>

  <!-- Services Section -->
  <section class="relative overflow-hidden bg-white pb-10 pt-16 md:pb-14 md:pt-24">
    <div class="container-page">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-sm font-extrabold uppercase tracking-widest text-primary">Our Services</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-dark-deeper md:text-5xl">
          Enhance your operations with <span class="inline-block rounded-md bg-primary px-2.5 py-0.5 align-baseline leading-tight text-white sm:px-3">ADYSURVE</span> services
        </h2>
      </div>

      {activeServices.length > 0 ? (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {activeServices.map((service) => (
            <a
              href={`/services/${service.id}`}
              class="group relative flex flex-col rounded-2xl border border-black/8 bg-white p-6 shadow-lg shadow-black/5 transition hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl sm:p-8"
            >
              <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary-dark transition group-hover:bg-primary group-hover:text-dark-deeper">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              </span>
              <h3 class="mt-5 font-display text-xl font-extrabold text-dark-deeper group-hover:text-primary-dark">{service.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-dark/65">{service.data.shortDescription}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary group-hover:text-primary-dark">
                Learn More
                <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-10 text-center text-dark/65">
          <p>No services available yet. Check back soon.</p>
        </div>
      )}

      <div class="mt-12 text-center">
        <a href="/services" class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-4 text-sm font-extrabold text-dark-deeper shadow-xl shadow-primary/20 transition hover:bg-primary-light">
          View All Services
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  {activeTestimonials.length > 0 && (
    <section class="bg-light py-16 md:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-extrabold uppercase tracking-widest text-primary">Testimonials</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-dark-deeper md:text-5xl">
            What our clients say
          </h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {activeTestimonials.map((t) => (
            <div class="rounded-2xl bg-white p-6 shadow-lg sm:p-8">
              <div class="flex items-center gap-1">
                {Array.from({ length: t.data.rating }).map(() => (
                  <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="mt-4 text-sm leading-7 text-dark/75 italic">&ldquo;{t.data.content}&rdquo;</p>
              <div class="mt-5 border-t border-black/5 pt-4">
                <p class="font-bold text-dark-deeper">{t.data.clientName}</p>
                {(t.data.clientTitle || t.data.clientCompany) && (
                  <p class="text-xs text-dark/60">{t.data.clientTitle}{t.data.clientTitle && t.data.clientCompany ? ', ' : ''}{t.data.clientCompany}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- About Section -->
  <section class="relative overflow-hidden bg-dark-deeper py-16 text-white md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(201,151,43,0.18),transparent_30%),radial-gradient(circle_at_78%_82%,rgba(232,184,75,0.10),transparent_34%)]"></div>
    <div class="container-page relative grid gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="relative">
        <div class="relative mx-auto max-w-[460px] border border-white/15 bg-white/[0.04] p-5 shadow-2xl shadow-black/25 backdrop-blur">
          <div class="relative overflow-hidden bg-[#090812] px-5 py-8 sm:px-8 sm:py-10">
            <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(201,151,43,0.20),transparent_35%),linear-gradient(315deg,rgba(255,255,255,0.12),transparent_30%)]"></div>
            <div class="relative flex min-h-[200px] flex-col justify-between">
              <div class="flex items-center justify-between">
                <div class="rounded-2xl bg-white p-4 shadow-xl">
                  <img src="/images/ady-logo.png" alt="ADYSURVE LTD logo" width="96" height="96" class="h-16 w-16 object-contain" />
                </div>
                <span class="rounded-full border border-primary/50 bg-primary/10 px-4 py-2 text-xs font-extrabold uppercase tracking-widest text-primary-light">Since launch</span>
              </div>
              <div class="mt-6">
                <h3 class="font-display text-2xl font-extrabold leading-tight sm:text-3xl">Integrated technology, security and energy solutions.</h3>
                <p class="mt-4 max-w-sm text-sm leading-7 text-white/70">Reliable systems for organizations that need better connectivity, stronger protection and sustainable growth.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <p class="inline-flex items-center gap-2 text-sm font-extrabold text-primary">
          <span class="h-2 w-2 rounded-full border-2 border-primary"></span>
          About Us
        </p>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-extrabold leading-tight md:text-5xl">
          Learn about the mission and values that drive us at <span class="rounded-md bg-primary/20 px-3 text-primary-light">ADYSURVE</span>
        </h2>
        <p class="mt-5 max-w-2xl leading-8 text-white/70">
          {s?.aboutSummary || 'ADYSURVE LTD is a forward-thinking technology and engineering company committed to delivering reliable IT infrastructure, smart security systems, renewable energy solutions, and digital communication services.'}
        </p>
        <a href="/about" class="mt-9 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-extrabold text-dark-deeper shadow-xl shadow-primary/20 transition hover:bg-primary-light">
          More About Us
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  {recentPosts.length > 0 && (
    <section class="bg-white py-16 md:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-extrabold uppercase tracking-widest text-primary">From Our Blog</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-dark-deeper md:text-5xl">
            Latest insights & updates
          </h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="group flex flex-col overflow-hidden rounded-2xl border border-black/8 bg-white shadow-lg shadow-black/5 transition hover:-translate-y-1 hover:shadow-xl">
              {post.data.featuredImage && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img src={post.data.featuredImage} alt="" width="600" height="338" loading="lazy" class="h-full w-full object-cover transition group-hover:scale-105" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-5 sm:p-6">
                {post.data.category && (
                  <span class="mb-3 inline-block self-start rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary-dark">{post.data.category}</span>
                )}
                <h3 class="font-display text-lg font-extrabold leading-snug text-dark-deeper group-hover:text-primary-dark">{post.data.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-7 text-dark/65">{post.data.excerpt}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-primary group-hover:text-primary-dark">
                  Read More
                  <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/blog" class="inline-flex items-center gap-2 rounded-full bg-dark-deeper px-7 py-4 text-sm font-extrabold text-white transition hover:bg-primary hover:text-dark-deeper">
            View All Posts
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17l9.2-9.2M17 17V7H7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Banner -->
  <section class="bg-primary py-16 text-dark-deeper">
    <div class="container-page flex flex-col items-stretch justify-between gap-6 md:flex-row md:items-center">
      <h2 class="font-display text-3xl font-extrabold md:text-5xl">Ready to book your free consultation?</h2>
      <a href="/contact#free-consultation" class="rounded-full bg-dark-deeper px-7 py-4 text-center font-bold text-white">Book Free Consultation</a>
    </div>
  </section>
</Layout>
