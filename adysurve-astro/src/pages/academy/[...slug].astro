---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const programs = await getCollection('academy');
  return programs.map((program) => ({
    params: { slug: program.id },
    props: { program },
  }));
}

const { program } = Astro.props;
const { data } = program;

const courseSchema = {
  '@type': 'Course',
  name: data.title,
  description: data.metaDescription,
  provider: {
    '@type': 'Organization',
    name: 'Megabyte Academy, a training arm of ADYSURVE LTD',
  },
  offers: {
    '@type': 'Offer',
    category: 'Training Program',
    availability: 'https://schema.org/InStock',
  },
};
---

<Layout
  title={data.metaTitle}
  description={data.metaDescription}
  schema={courseSchema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-dark-deeper py-16 text-white md:py-32">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(201,151,43,0.22),transparent_32%),radial-gradient(circle_at_82%_72%,rgba(255,255,255,0.08),transparent_30%)]"></div>
    <div class="container-page relative grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="inline-flex max-w-full items-center gap-2 rounded-full border border-primary/40 bg-primary/10 px-3 py-2 text-[10px] font-extrabold uppercase tracking-[0.12em] text-primary-light sm:px-4 sm:text-xs sm:tracking-widest">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
          <span class="truncate">Megabyte Academy - A Training Arm of ADYSURVE LTD</span>
        </p>
        <h1 class="mt-6 max-w-5xl font-display text-3xl font-extrabold leading-tight md:text-6xl">{data.title}</h1>
        <h2 class="mt-4 max-w-4xl font-display text-xl font-extrabold leading-tight text-primary-light md:text-3xl">{data.subtitle}</h2>
        <h3 class="mt-4 text-lg font-extrabold text-white sm:text-xl">{data.kicker}</h3>

        <div class="mt-6 max-w-3xl space-y-4 text-base leading-8 text-white/74 sm:text-lg">
          {data.intro.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>

        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <a href={`/contact?service=${encodeURIComponent(data.service)}`} class="rounded-full bg-primary px-7 py-4 text-center text-sm font-extrabold text-dark-deeper shadow-xl shadow-primary/20 transition hover:bg-primary-light">
            Enroll Today
          </a>
          <a href="#curriculum" class="rounded-full border border-white/35 px-7 py-4 text-center text-sm font-extrabold text-white transition hover:border-primary hover:text-primary-light">
            View Curriculum
          </a>
        </div>
      </div>

      <!-- Sidebar Card -->
      <div class="relative">
        <div class="absolute -inset-6 rounded-[2rem] bg-primary/10 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-lg border border-white/15 bg-white/[0.06] p-6 shadow-2xl shadow-black/30 backdrop-blur">
          <div class="rounded-lg bg-white p-6 text-dark-deeper">
            <p class="text-sm font-extrabold uppercase tracking-widest text-primary-dark">Training Duration</p>
            <p class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">{data.duration}</p>
            <div class="mt-7 grid gap-4">
              {data.facts.map((fact) => (
                <div class="flex gap-4 rounded-lg bg-light p-4">
                  <svg class="h-7 w-7 shrink-0 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                  <div>
                    <p class="text-xs font-extrabold uppercase tracking-widest text-dark/45">{fact.label}</p>
                    <p class="mt-1 font-bold">{fact.value}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Section -->
  <section class="bg-white py-16 md:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-widest text-primary">{data.why.label}</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-dark-deeper md:text-5xl">{data.why.heading}</h2>
        <p class="mt-6 leading-8 text-dark/68">{data.why.text}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {data.why.items.map((item) => (
          <div class="flex gap-3 rounded-lg border border-black/10 bg-light p-5">
            <svg class="h-6 w-6 shrink-0 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <p class="font-bold leading-7 text-dark-deeper">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Curriculum Section -->
  <section id="curriculum" class="bg-light py-16 md:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-sm font-extrabold uppercase tracking-widest text-primary">What You Will Learn</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-dark-deeper md:text-5xl">{data.curriculum.heading}</h2>
        <p class="mt-5 leading-8 text-dark/65">{data.curriculum.text}</p>
      </div>

      <div class="mt-10 grid gap-5 lg:mt-14 lg:grid-cols-2">
        {data.curriculum.modules.map(([title, items]) => (
          <article class="rounded-lg border border-black/10 bg-white p-5 shadow-sm sm:p-7">
            <h3 class="font-display text-xl font-extrabold text-dark-deeper sm:text-2xl">{title}</h3>
            <ul class="mt-5 grid gap-3 text-dark/70">
              {items.map((item) => (
                <li class="flex gap-3">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Corporate Training Section -->
  <section class="bg-dark-deeper py-16 text-white md:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-widest text-primary">{data.corporate.label}</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight md:text-5xl">{data.corporate.heading}</h2>
        <div class="mt-6 space-y-5 leading-8 text-white/72">
          {data.corporate.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          {data.corporate.methods.map((method) => (
            <div class="rounded-lg border border-white/15 bg-white/5 p-4 text-sm font-bold text-white/82">{method}</div>
          ))}
        </div>
      </div>
      <div class="rounded-lg border border-white/15 bg-white/[0.06] p-7">
        <h3 class="font-display text-2xl font-extrabold">{data.corporate.panelHeading}</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {data.corporate.items.map((item) => (
            <div class="flex gap-3">
              <svg class="h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="font-bold text-white/85">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Cards Section (Apply / Benefits / Careers) -->
  <section class="bg-white py-16 md:py-28">
    <div class="container-page grid gap-5 lg:grid-cols-3">
      {Object.entries(data.cards).map(([type, card], index) => (
        <article class={`rounded-lg border border-black/10 ${index % 2 === 0 ? 'bg-white shadow-sm' : 'bg-light'} p-5 sm:p-7`}>
          <h2 class="font-display text-2xl font-extrabold text-dark-deeper sm:text-3xl">{card.heading}</h2>
          <p class="mt-4 leading-8 text-dark/68">{card.intro}</p>
          <ul class="mt-5 grid gap-3 text-dark/72">
            {card.items.map((item) => (
              <li class="flex gap-3">
                {type === 'careers' ? (
                  <svg class="mt-1 h-5 w-5 shrink-0 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                ) : (
                  <svg class="mt-1 h-5 w-5 shrink-0 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                )}
                {item}
              </li>
            ))}
          </ul>
          {card.note && (
            <p class="mt-5 font-bold text-dark-deeper">{card.note}</p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-primary py-16 text-dark-deeper">
    <div class="container-page grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-widest">Enroll Today</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight md:text-5xl">{data.cta.heading}</h2>
  {data.cta.paragraphs.map((paragraph) => (
    <p class="mt-5 max-w-4xl text-lg font-medium leading-8" set:html={paragraph} />
  ))}
        <p class="mt-6 font-display text-2xl font-extrabold">ADYSURVE LTD</p>
        <p class="font-bold">Smart Solutions for a Secure Future.</p>
      </div>
      <a href={`/contact?service=${encodeURIComponent(data.service)}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-dark-deeper px-8 py-4 text-sm font-extrabold text-white shadow-xl transition hover:bg-black">
        Enroll Today
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17l9.2-9.2M17 17V7H7"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>
