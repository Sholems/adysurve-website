---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { data } = service;
---

<Layout
  title={`${data.metaTitle || data.title + ' | ADYSURVE'} | ADYSURVE LTD`}
  description={data.metaDescription || data.shortDescription}
  image={data.featuredImage}
>
  <section class="bg-dark-deeper py-14 text-white sm:py-20">
    <div class="container-page">
      <a href="/services" class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-light">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        Back to Services
      </a>
      <p class="text-sm font-bold uppercase tracking-widest text-primary">{data.icon ? data.icon.replace('heroicon-o-', '').replace(/-/g, ' ') : 'Service'}</p>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">{data.title}</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-white/75 sm:text-lg">{data.shortDescription}</p>
    </div>
  </section>

  <section class="py-16 md:py-28">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_0.9fr]">
        <article class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-dark-deeper prose-p:text-[var(--color-text-muted)] prose-strong:text-dark-deeper">
          <div set:html={data.fullDescription} />
        </article>

        <aside class="lg:pl-4">
          <div class="sticky top-28 rounded-2xl border border-black/8 bg-white p-6 shadow-lg sm:p-8">
            {data.featuredImage && (
              <div class="-mx-6 -mt-6 mb-6 overflow-hidden rounded-t-2xl sm:-mx-8 sm:-mt-8">
                <img src={data.featuredImage} alt={data.title} width="600" height="400" loading="lazy" class="w-full object-cover" />
              </div>
            )}
            <h3 class="font-display text-xl font-extrabold text-dark-deeper">Ready to get started?</h3>
            <p class="mt-2 text-sm leading-7 text-dark/65">Contact us today to discuss how we can help with your {data.title.toLowerCase()} needs.</p>
            <a href={`/contact?service=${service.id}`} class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-center text-sm font-extrabold text-dark-deeper transition hover:bg-primary-light">
              Request Service
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary py-16 text-dark-deeper">
    <div class="container-page flex flex-col items-stretch justify-between gap-6 md:flex-row md:items-center">
      <h2 class="font-display text-3xl font-extrabold md:text-4xl">Need a reliable partner for {data.title.toLowerCase()}?</h2>
      <a href="/contact" class="rounded-full bg-dark-deeper px-7 py-4 text-center font-bold text-white">Contact Us Today</a>
    </div>
  </section>
</Layout>
