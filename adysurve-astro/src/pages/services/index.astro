---
import Layout from '../../layouts/Layout.astro';
import { getServices } from '../../lib/content';

const services = await getServices();
const activeServices = services
  .filter((s) => s.data.isActive)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<Layout
  title="Services | ADYSURVE LTD"
  description="Explore ADYSURVE services across networks, security, CCTV surveillance, solar renewable energy, IT training, and media communication."
>
  <section class="bg-dark-deeper py-14 text-white sm:py-20">
    <div class="container-page">
      <p class="text-sm font-bold uppercase tracking-widest text-primary">ADYSURVE LTD</p>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">Services</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-white/75 sm:text-lg">Focused technology, security, power, training, and media support for Nigerian organizations.</p>
    </div>
  </section>

  <section class="py-16 md:py-28">
    <div class="container-page">
      {activeServices.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {activeServices.map((service) => (
            <a
              href={`/services/${service.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-black/8 bg-white shadow-lg shadow-black/5 transition hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl"
            >
              {service.data.featuredImage && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img src={service.data.featuredImage} alt="" width="600" height="338" loading="lazy" class="h-full w-full object-cover transition group-hover:scale-105" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6 sm:p-8">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary-dark transition group-hover:bg-primary group-hover:text-dark-deeper">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                </span>
                <h2 class="mt-4 font-display text-xl font-extrabold text-dark-deeper">{service.data.title}</h2>
                <p class="mt-3 flex-1 text-sm leading-7 text-dark/65">{service.data.shortDescription}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary group-hover:text-primary-dark">
                  Learn More
                  <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center text-dark/65">
          <p>No services available yet. Check back soon.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
