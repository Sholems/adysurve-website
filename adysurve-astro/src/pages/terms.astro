---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms | ADYSURVE LTD"
  description="Review the basic terms that guide use of the ADYSURVE LTD website and service inquiries."
>
  <section class="bg-dark-deeper py-14 text-white sm:py-20">
    <div class="container-page">
      <p class="text-sm font-bold uppercase tracking-widest text-primary">ADYSURVE LTD</p>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">Terms</h1>
    </div>
  </section>

  <section class="py-20">
    <div class="container-page prose prose-lg max-w-4xl">
      <p>This website provides general information about ADYSURVE LTD services. Final project scope, pricing, timelines, and support commitments are confirmed through written quotations or agreements.</p>
      <p>By using this website, you agree not to misuse forms, content, or contact channels.</p>
    </div>
  </section>
</Layout>
