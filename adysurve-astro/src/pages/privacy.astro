---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Privacy Policy | ADYSURVE LTD"
  description="Read how ADYSURVE LTD handles personal information submitted through this website."
>
  <section class="bg-dark-deeper py-14 text-white sm:py-20">
    <div class="container-page">
      <p class="text-sm font-bold uppercase tracking-widest text-primary">ADYSURVE LTD</p>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">Privacy Policy</h1>
    </div>
  </section>

  <section class="py-20">
    <div class="container-page prose prose-lg max-w-4xl">
      <p>ADYSURVE LTD collects information submitted through contact forms only for responding to inquiries, preparing service conversations, and improving client support.</p>
      <p>We do not sell personal information. Submitted details may be stored securely for business communication and legal record purposes.</p>
    </div>
  </section>
</Layout>
