---
export interface Props {
  eyebrow?: string | null;
  title: string;
  subtitle?: string | null;
  theme?: 'light' | 'dark';
}

const { eyebrow, title, subtitle, theme = 'light' } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center">
  {eyebrow && (
    <p class="text-sm font-bold uppercase tracking-widest text-primary">{eyebrow}</p>
  )}
  <h2
    class:list={[
      'mt-3 font-display text-3xl font-extrabold md:text-5xl',
      theme === 'dark' ? 'text-white' : 'text-dark-deeper',
    ]}
  >
    {title}
  </h2>
  {subtitle && (
    <p
      class:list={[
        'mt-4 text-lg leading-8',
        theme === 'dark' ? 'text-white/70' : 'text-[var(--color-text-muted)]',
      ]}
    >
      {subtitle}
    </p>
  )}
</div>
