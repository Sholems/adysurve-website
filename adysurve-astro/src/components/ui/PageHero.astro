---
export interface Props {
  title: string;
  subtitle?: string | null;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-dark-deeper py-14 text-white sm:py-20">
  <div class="container-page">
    <p class="text-sm font-bold uppercase tracking-widest text-primary">ADYSURVE LTD</p>
    <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold leading-tight md:text-6xl">{title}</h1>
    {subtitle && (
      <p class="mt-5 max-w-3xl text-base leading-8 text-white/75 sm:text-lg">{subtitle}</p>
    )}
  </div>
</section>
