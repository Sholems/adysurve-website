---
import { getAcademyPrograms, getServices } from '../lib/content';

const services = await getServices();
const academyPrograms = await getAcademyPrograms();
---

<header x-data="{ open: false }" class="sticky top-0 z-50 border-b border-black/5 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-3 md:h-20">
    <!-- Logo -->
    <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-3" aria-label="ADYSURVE LTD home">
      <img src="/images/ady-logo.png" alt="" width="90" height="84" class="h-10 w-auto shrink-0 object-contain sm:h-12" />
      <span class="min-w-0 leading-none">
        <span class="block truncate font-display text-base font-extrabold tracking-normal text-dark-deeper sm:text-xl">ADYSURVE LTD</span>
        <span class="mt-1 block max-w-[190px] truncate text-[8px] font-bold uppercase tracking-[0.12em] text-primary-dark sm:max-w-none sm:text-[10px] sm:tracking-widest">Smart Solutions for a Secure Future</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 text-sm font-bold text-dark md:flex">
      <a href="/" class="hover:text-primary">Home</a>
      <a href="/about" class="hover:text-primary">About</a>

      <!-- Services Dropdown -->
      <div class="group relative">
        <a href="/services" class="inline-flex items-center gap-1 hover:text-primary">
          Services
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-[26rem] -translate-x-1/2 translate-y-4 rounded-lg border border-black/5 bg-white p-3 opacity-0 shadow-2xl shadow-black/15 transition group-hover:visible group-hover:translate-y-2 group-hover:opacity-100">
          <div class="rounded-lg bg-dark-deeper px-4 py-3 text-white">
            <p class="text-xs font-extrabold uppercase tracking-widest text-primary">Our Services</p>
            <p class="mt-1 text-sm text-white/70">Professional technology, security, energy, and media solutions.</p>
          </div>
          <div class="mt-3 grid gap-2">
            {services.sort((a, b) => a.data.sortOrder - b.data.sortOrder).map((service) => (
              <a
                href={`/services/${service.id}`}
                class="group/item flex gap-4 rounded-lg border border-transparent p-3 transition hover:border-primary/30 hover:bg-light"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary-dark transition group-hover/item:bg-primary group-hover/item:text-dark-deeper">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                </span>
                <span>
                  <span class="block font-display text-sm font-extrabold leading-snug text-dark-deeper group-hover/item:text-primary-dark">{service.data.title}</span>
                  <span class="mt-1 block text-xs leading-5 text-dark/58">{service.data.shortDescription}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/projects" class="hover:text-primary">Projects</a>

      <!-- Academy Dropdown -->
      <div class="group relative">
        <a href="/academy/network-security" class="inline-flex items-center gap-1 hover:text-primary">
          Megabyte Academy
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-[28rem] -translate-x-1/2 translate-y-4 rounded-lg border border-black/5 bg-white p-3 opacity-0 shadow-2xl shadow-black/15 transition group-hover:visible group-hover:translate-y-2 group-hover:opacity-100">
          <div class="rounded-lg bg-dark-deeper px-4 py-3 text-white">
            <p class="text-xs font-extrabold uppercase tracking-widest text-primary">Megabyte Academy</p>
            <p class="mt-1 text-sm text-white/70">A training arm of ADYSURVE LTD</p>
          </div>
          <div class="mt-3 grid gap-2">
            {academyPrograms.map((program) => (
              <a
                href={`/academy/${program.id}`}
                class="group/item flex gap-4 rounded-lg border border-transparent p-3 transition hover:border-primary/30 hover:bg-light"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary-dark transition group-hover/item:bg-primary group-hover/item:text-dark-deeper">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                </span>
                <span>
                  <span class="block font-display text-sm font-extrabold leading-snug text-dark-deeper group-hover/item:text-primary-dark">{program.data.title}</span>
                  <span class="mt-1 block text-xs leading-5 text-dark/58">{program.data.service}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/blog" class="hover:text-primary">Blog</a>
      <a href="/contact" class="rounded-full bg-primary px-5 py-3 text-dark-deeper hover:bg-primary-light">Contact Us</a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button type="button" class="shrink-0 rounded-lg p-2 md:hidden" @click="open = !open" aria-label="Toggle navigation">
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div x-show="open" x-cloak class="border-t bg-white md:hidden">
    <div class="container-page grid max-h-[calc(100vh-4rem)] gap-3 overflow-y-auto py-5 text-sm font-bold">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      {services.sort((a, b) => a.data.sortOrder - b.data.sortOrder).map((service) => (
        <a href={`/services/${service.id}`} class="flex items-center gap-3 pl-4 text-dark/70">
          <span class="text-primary-dark">{service.data.title}</span>
        </a>
      ))}
      <a href="/projects">Projects</a>
      <a href="/academy/network-security">Megabyte Academy</a>
      {academyPrograms.map((program) => (
        <a href={`/academy/${program.id}`} class="flex items-center gap-3 pl-4 text-dark/70">
          <span class="text-primary-dark">{program.data.title}</span>
        </a>
      ))}
      <a href="/blog">Blog</a>
      <a href="/contact" class="rounded-full bg-primary px-5 py-3 text-center text-dark-deeper">Contact Us</a>
    </div>
  </div>
</header>
