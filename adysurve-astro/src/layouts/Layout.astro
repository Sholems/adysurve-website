---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, any> | null;
}

const {
  title = 'ADYSURVE LTD | IT, Security, CCTV, Solar & Media Solutions',
  description = 'ADYSURVE LTD delivers professional IT infrastructure, CCTV surveillance, solar energy, IT training, and graphic design solutions in Nigeria.',
  image,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <SEOHead title={title} description={description} image={image} schema={schema} />
  </head>
  <body class="min-h-screen" x-data>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/alpine.js"></script>
  </body>
</html>
